{
  "name": "dsh-knowledge",
  "version": "1.0.1",
  "description": "A Markdown-first knowledge library for DeepSeek Harness with one-click local Qwen search.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": "github:averyjohnkucan-arch/dsh-knowledge",
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.2-rc.4 <0.3.0"
  },
  "main": "./src/host/plugin.js",
  "exports": {
    ".": "./src/host/plugin.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "src",
    "dist",
    "scripts",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "LICENSE",
    "README.md",
    "locale",
    "icon.svg"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "check": "npm run test && npm run build",
    "smoke": "node scripts/smoke-models.mjs"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "mupdf": "1.28.0",
    "onnxruntime-node": "1.30.0"
  },
  "optionalDependencies": {
    "openvino-node": "2026.4.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
